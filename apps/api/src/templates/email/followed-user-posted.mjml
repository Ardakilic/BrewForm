<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-button background-color="#6F4E37" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F5F0EB">
    <mj-section>
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#3E2723" align="center">
          ☕ A brewer you follow posted a new recipe
        </mj-text>
        <mj-text font-size="16px" color="#5D4037" align="center">
          Hey {{username}},
        </mj-text>
        <mj-text font-size="16px" color="#5D4037" align="center">
          <strong>{{author_username}}</strong> just shared <strong>{{recipe_title}}</strong>.
        </mj-text>
        <mj-button href="{{recipe_url}}" font-size="16px">
          Take a look
        </mj-button>
        <mj-text font-size="12px" color="#8D6E63" align="center">
          You can turn off these notifications in your account preferences.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
