<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-button background-color="#6F4E37" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F5F0EB">
    <mj-section>
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#3E2723" align="center">
          ☕ You have a new follower on {{app_name}}
        </mj-text>
        <mj-text font-size="16px" color="#5D4037" align="center">
          Hey {{username}},
        </mj-text>
        <mj-text font-size="16px" color="#5D4037" align="center">
          <strong>{{follower_username}}</strong> just started following you. Say hi back, share a recipe, or check out what they've been brewing.
        </mj-text>
        <mj-button href="{{follower_url}}" font-size="16px">
          View profile
        </mj-button>
        <mj-text font-size="12px" color="#8D6E63" align="center">
          You can turn off these notifications in your account preferences.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
