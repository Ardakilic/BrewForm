# ============================================================
# BrewForm API — Runtime Environment (paste into Coolify API resource)
# ============================================================
# This file documents ALL env vars the API container reads at runtime.
# Copy to .env for local dev, or paste into Coolify's Environment Variables
# tab (Developer view) for the API Docker Image resource.
#
# The root .env.example is still used by compose for local-dev infrastructure
# (Postgres, Garage, pgAdmin). This file is the API-only runtime reference.

# === Application ===
APP_PORT=8000
APP_ENV=production
LOG_LEVEL=info
# LOG_FORMAT: 'json' (default, structured JSON) or 'pretty' (human-readable for development)
LOG_FORMAT=json
# Public app URL used by share links and email notifications.
PUBLIC_APP_URL=https://brewform.example.com
# Base URL the API uses to build absolute links server-side — most importantly the
# QR code target (<APP_URL>/recipes/<slug>) plus the canonical/share/sitemap fallback.
# Distinct from PUBLIC_APP_URL: QR codes read APP_URL directly (no fallback), so it
# defaults to http://localhost:8000 and MUST be set to your public web URL in
# production or scanned QR codes will embed http://localhost:8000.
APP_URL=https://brewform.example.com

# === Database (PostgreSQL) ===
# In Coolify: use the INTERNAL hostname from the Postgres Connection tab
# (e.g. postgres-<uuid>), NOT localhost.
DATABASE_URL=postgresql://brewform:brewform@localhost:5432/brewform
DATABASE_PROVIDER=postgresql

# === Cache Driver ===
# "memory" for an in-memory/local cache (dev/test), "deno-kv" for production.
# When CACHE_DRIVER=deno-kv, the API connects to the denokv sidecar.
# Requires DENO_KV_URL and DENO_KV_ACCESS_TOKEN.
CACHE_DRIVER=deno-kv

# === Deno KV (remote denokv sidecar) ===
# URL of the denokv server. Defaults to http://denokv:4512 (the compose service name).
# In Coolify, use the denokv resource's internal hostname: http://denokv-<uuid>:4512
DENO_KV_URL=http://denokv:4512
# Bearer token for the denokv server. Generate with: openssl rand -hex 32
# Must match the --access-token passed to the denokv container in compose.yml / Coolify.
DENO_KV_ACCESS_TOKEN=

# === Authentication ===
# Min 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# When "Remember Me" is checked on login, the refresh token uses this expiry.
# Default: 180d (~6 months). Supports s/m/h/d/M suffixes.
# M = 30 days (not calendar month).
JWT_REMEMBER_ME_EXPIRY=180d

# === Admin Setup (seeded on first boot only) ===
ADMIN_EMAIL=admin@brewform.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# === CORS ===
# The web SPA's public origin (scheme + host, no trailing slash, no port if 443).
# For subdomain routing: https://brewform.example.com
CORS_ALLOWED_ORIGINS=https://brewform.example.com

# === Email (SMTP) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@brewform.local

# === OpenAPI ===
OPENAPI_ENABLED=true

# === Registration ===
# Set to 'false' to disable new user registrations.
# Existing users can still log in. Default: true.
ENABLE_REGISTRATION=true

# === Storage ===
# "local" (serves /uploads from the container filesystem) or "s3" (Cloudflare R2, etc.)
# In production, use "s3" — no files are stored on the Coolify server.
STORAGE_DRIVER=s3

# S3-compatible storage (required when STORAGE_DRIVER=s3)
# For Cloudflare R2:
#   S3_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION   = auto
#   S3_PUBLIC_URL = your R2 public bucket URL (or custom domain)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=brewform-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=http://localhost:3902/brewform-uploads