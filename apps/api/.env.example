# ============================================================
# BrewForm API — Runtime Environment (paste into Coolify API resource)
# ============================================================
# This file documents ALL env vars the API container reads at runtime.
# Copy to .env for local dev, or paste into Coolify's Environment Variables
# tab (Developer view) for the API Docker Image resource.
#
# The root .env.example is still used by compose for local-dev infrastructure
# (Postgres, Garage, pgAdmin). This file is the API-only runtime reference.

# === Application ===
APP_PORT=8000
APP_ENV=production
LOG_LEVEL=info
# LOG_FORMAT: 'json' (default, structured JSON) or 'pretty' (human-readable for development)
LOG_FORMAT=json
# Public app URL used by share links and email notifications.
PUBLIC_APP_URL=https://brewform.example.com
# Base URL the API uses to build absolute links server-side — most importantly the
# QR code target (<APP_URL>/recipes/<slug>) plus the canonical/share/sitemap fallback.
# Distinct from PUBLIC_APP_URL: QR codes read APP_URL directly (no fallback), so it
# defaults to http://localhost:8000 and MUST be set to your public web URL in
# production or scanned QR codes will embed http://localhost:8000.
APP_URL=https://brewform.example.com

# === Database (PostgreSQL) ===
# In Coolify: use the INTERNAL hostname from the Postgres Connection tab
# (e.g. postgres-<uuid>), NOT localhost.
DATABASE_URL=postgresql://brewform:brewform@localhost:5432/brewform
DATABASE_PROVIDER=postgresql

# === Cache ===
# CACHE_ENABLED=false disables all caching; it does not affect rate limiting.
# CACHE_DRIVER: "memory" (process-local default) or "redis" (shared Valkey
# service in compose.yml / compose.production.yml). The redis driver requires
# REDIS_URL to be set. Any Redis-protocol server works (Redis or Valkey).
# Production compose builds REDIS_URL from VALKEY_PASSWORD automatically.
# CACHE_MEMORY_MAX_ENTRIES caps the memory driver (LRU eviction, 100-1000000).
CACHE_ENABLED=true
CACHE_DRIVER=memory
REDIS_URL=redis://:dev-valkey-password@valkey:6379
CACHE_MEMORY_MAX_ENTRIES=10000

# === Client IP / trusted proxies (rate limiting) ===
# Which forwarding headers the API trusts to find the client address:
#   none       - the TCP peer only; every forwarding header is ignored (the
#                secure code default; behind a proxy all clients then share one
#                bucket, and the API logs one warning when X-Forwarded-For arrives)
#   hops       - the right-most X-Forwarded-For entry after TRUST_PROXY_HOPS
#                trusted proxies (the socket peer counts as the first one)
#   cloudflare - like hops, but CF-Connecting-IP is used when the selected hop
#                is a Cloudflare edge (bundled ranges) or in TRUST_PROXY_CIDRS
# Behind Coolify's Traefik (one proxy in front of the API) use hops with 1.
TRUST_PROXY=hops
TRUST_PROXY_HOPS=1
# Behind Cloudflare, use cloudflare mode AND lock the origin down (firewall the
# server to Cloudflare's IP ranges, or use a Cloudflare Tunnel) so nobody can
# reach the API directly; CF-Connecting-IP is only honoured from Cloudflare edges.
# TRUST_PROXY=cloudflare
# Extra trusted edge CIDRs for cloudflare mode, comma-separated, IPv4 or IPv6:
# TRUST_PROXY_CIDRS=

# === Rate limiting ===
# RATE_LIMIT_ENABLED=false is the only switch that turns rate limiting off.
# RATE_LIMIT_STORE: "memory" (per process) or "redis" (shared across replicas;
# reuses REDIS_URL on its own connection, keys under brewform-rl:, falls back to
# per-process limits while Valkey is down).
# RATE_LIMIT_GLOBAL_MAX: requests per 60 s per client on every route except
# /health, /ready and local /uploads/*.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
RATE_LIMIT_GLOBAL_MAX=100

# === Authentication ===
# Min 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# When "Remember Me" is checked on login, the refresh token uses this expiry.
# Default: 180d (~6 months). Supports s/m/h/d/M suffixes.
# M = 30 days (not calendar month).
JWT_REMEMBER_ME_EXPIRY=180d

# === Admin Setup (seeded on first boot only) ===
# Used only when the users table is empty; changing these later has no effect
# (existing rows are never updated). Rotate credentials via the app instead.
ADMIN_EMAIL=admin@brewform.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# === CORS ===
# The web SPA's public origin (scheme + host, no trailing slash, no port if 443).
# For subdomain routing: https://brewform.example.com
CORS_ALLOWED_ORIGINS=https://brewform.example.com

# === Email (SMTP) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@brewform.local

# === OpenAPI ===
OPENAPI_ENABLED=true

# === Registration ===
# Set to 'false' to disable new user registrations.
# Existing users can still log in. Default: true.
ENABLE_REGISTRATION=true

# === Storage ===
# "local" (serves /uploads from the container filesystem) or "s3" (Cloudflare R2, etc.)
# In production, use "s3" — no files are stored on the Coolify server.
STORAGE_DRIVER=s3

# S3-compatible storage (required when STORAGE_DRIVER=s3)
# For Cloudflare R2:
#   S3_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION   = auto
#   S3_PUBLIC_URL = your R2 public bucket URL (or custom domain)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=brewform-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=http://localhost:3902/brewform-uploads