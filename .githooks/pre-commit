#!/bin/sh
# BrewForm pre-commit hook
# Runs Biome format check and per-workspace lint before each commit.
# (Mirrors the root `fmt-check` and `lint` scripts: api + web + db + shared.)
#
# Install once after cloning:
#   make setup-hooks
# Or manually:
#   git config core.hooksPath .githooks

set -e

echo "Pre-commit: checking formatting..."
pnpm run fmt-check

echo "Pre-commit: linting..."
pnpm run lint
