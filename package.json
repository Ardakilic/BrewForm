{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run check",
    "db:generate": "deno run -A npm:prisma@^6.19.3 generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "deno run -A npm:prisma@^6.19.3 migrate deploy --schema=packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "prisma": "^6.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "@std/expect": "jsr:@std/expect@^1.0.19"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "nodemailer": "^8.0.6",
    "pino-pretty": "^13.1.3"
  }
}
