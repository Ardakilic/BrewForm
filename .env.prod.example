# ================================================================
# BrewForm — Production Environment Variables
# Copy this to Deno Deploy dashboard (Settings → Environment Variables)
# Variables are separated into Build Context and Production Context.
# ================================================================

# ================================================================
# 🔨 BUILD CONTEXT (used during deploy build step)
# ================================================================
# Required by: deno task --cwd ../../packages/db generate
# Drizzle Kit needs DB access to generate migration SQL.
DATABASE_URL=postgresql://user:password@pooler-host:5432/dbname?sslmode=require


# ================================================================
# 🚀 PRODUCTION CONTEXT (used at runtime by the API)
# ================================================================

# --- Application ---
# APP_ENV=production             # Set to 'production'
# LOG_LEVEL=info                 # 'debug', 'info', 'warn', 'error'
# LOG_FORMAT=json                # 'json' (structured) or 'pretty' (human-readable)
# APP_URL=https://api.brewform.cc # API's public URL
# PUBLIC_APP_URL=https://brewform.cc # Frontend URL (used in share links, emails)

# --- Database (PostgreSQL) ---
# Use a POOLED connection string (e.g., Neon's pooled endpoint or Supabase PgBouncer on port 6543).
# Serverless platforms open/close connections frequently — pooling prevents exhaustion.
DATABASE_URL=postgresql://user:password@pooler-host:5432/dbname?sslmode=require
# DATABASE_PROVIDER=postgresql

# --- Cache ---
# CACHE_DRIVER=deno-kv           # Deno KV is auto-provisioned on Deno Deploy

# --- Authentication ---
JWT_SECRET=                     # Generate: openssl rand -hex 32 (must be ≥16 chars)
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d
# JWT_REMEMBER_ME_EXPIRY=180d    # When "Remember Me" is checked. Supports s/m/h/d/M suffixes. M = 30 days.

# --- Admin Setup ---
ADMIN_EMAIL=admin@brewform.cc
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                 # Strong password for admin account

# --- CORS ---
# Comma-separated list of allowed origins. No trailing spaces.
CORS_ALLOWED_ORIGINS=https://brewform.cc,https://www.brewform.cc

# --- Email (SMTP) ---
# Recommended free-tier providers:
#   Mailtrap (100/month):  live.smtp.mailtrap.io:587
#   SendGrid (100/day):    smtp.sendgrid.net:587
#   Resend (100/day):      smtp.resend.com:587
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false              # 'true' for port 465, 'false' for port 587
EMAIL_FROM=noreply@brewform.cc

# --- OpenAPI ---
# OPENAPI_ENABLED=true           # Set 'false' to hide /api/v1/openapi docs in production

# --- Registration ---
# ENABLE_REGISTRATION=true       # Set 'false' to disable new user sign-ups

# --- Storage ---
STORAGE_DRIVER=                 # 's3' for production, 'local' for dev only

# Only needed if STORAGE_DRIVER=s3:
# Recommended free-tier S3-compatible providers:
#   Cloudflare R2 (10 GB, no egress):  endpoint: https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2 (10 GB):              endpoint: https://s3.<region>.backblazeb2.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# --- Upload Limits ---
# UPLOAD_DIR=./uploads
# UPLOAD_MAX_SIZE_BYTES=10485760  # 10 MB
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp