# ============================================================
# BrewForm — Local Development Environment (compose infra)
# ============================================================
# This file is read by docker compose for LOCAL DEVELOPMENT infrastructure only
# (Postgres, Garage, pgAdmin, Mailpit). It is NOT used by Coolify.
#
# API runtime env vars:    apps/api/.env.example  (paste into Coolify API resource)
# Web build-time env vars: apps/web/.env.example (set as GitHub Secrets)
# ============================================================

# === Cache (local dev) ===
# CACHE_ENABLED=false disables all caching; it does not affect rate limiting.
# CACHE_DRIVER: "memory" (process-local default) or "redis" (shared Valkey
# service in compose.yml). The redis driver requires REDIS_URL to be set.
# The Redis protocol is shared by Redis and Valkey servers alike.
# VALKEY_PASSWORD sets the Valkey requirepass (compose.yml defaults to
# dev-valkey-password when unset).
# CACHE_MEMORY_MAX_ENTRIES caps the memory driver (LRU eviction).
CACHE_ENABLED=true
CACHE_DRIVER=memory
REDIS_URL=redis://:dev-valkey-password@valkey:6379
VALKEY_PASSWORD=dev-valkey-password
CACHE_MEMORY_MAX_ENTRIES=10000

# === Rate limiting (local dev) ===
# Local dev has no proxy in front of the API, so only the TCP peer is trusted.
# RATE_LIMIT_ENABLED=false is the only switch that turns rate limiting off;
# RATE_LIMIT_STORE=redis shares counters through Valkey (reuses REDIS_URL).
TRUST_PROXY=none
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
RATE_LIMIT_GLOBAL_MAX=100

# === PostgreSQL (local dev container) ===
POSTGRES_USER=brewform
POSTGRES_PASSWORD=brewform
POSTGRES_DB=brewform

# === Database query time budget (API) ===
# DB_STATEMENT_TIMEOUT_MS: server-side statement_timeout set on every pooled API
# connection, in milliseconds. Unset (or a non-integer/negative value) = 10000;
# 0 disables it. A query that runs longer is cancelled and the API answers
# 503 QUERY_TIMEOUT. compose.yml passes it through to the app service.
# DB_STATEMENT_TIMEOUT_MS=10000

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@brewform.local
PGADMIN_DEFAULT_PASSWORD=admin

# === Garage S3 (local development) ===
# Passed to the Garage container via compose.yml env_file.
# These values are pre-generated for local development.
# In production, generate new ones with:
#   printf "GK%s" $(openssl rand -hex 16)
#   openssl rand -hex 32
#   openssl rand -hex 32
GARAGE_DEFAULT_ACCESS_KEY=GK2ccae54ad3793a1324aba797fd9c62fc
GARAGE_DEFAULT_SECRET_KEY=023662d00d0b2b61b6f6f42717a9284f56e2912a73296fe750d4d7b50c98255a
GARAGE_DEFAULT_BUCKET=brewform-uploads
GARAGE_RPC_SECRET=cd87874aea22c73f5766ced61ac82193c2abe2f4c0f13b235c6258a0b27aeace
GARAGE_ADMIN_TOKEN=dev-admin-token-change-me-in-production

# === Photo uploads (API; defaults shown, uncomment to override) ===
# UPLOAD_MAX_SIZE_BYTES: per-photo limit in bytes; a positive integer (default 10 MiB).
#   The thumbnail limit is min(1 MiB, this value), and the /api/v1/photos request
#   body cap is this value + the thumbnail limit + 64 KiB.
# UPLOAD_ALLOWED_TYPES: comma-separated subset of image/jpeg, image/png and image/webp
#   (trimmed, case-insensitive). Any other entry fails API startup. Types are detected
#   from the file content, not from the declared Content-Type or the filename.
# UPLOAD_MAX_SIZE_BYTES=10485760
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
