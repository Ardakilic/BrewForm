# === Application ===
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=debug
# LOG_FORMAT: 'json' (default, structured JSON) or 'pretty' (human-readable for development)
LOG_FORMAT=pretty
# Public app URL used by share links and email notifications.
# Set this to your public app domain to avoid silently falling back to
# https://brewform.cc (production) or http://localhost:5173 (development).
PUBLIC_APP_URL=https://your-app.example.com

# === Web (Vite) ===
# Used by index.html for absolute og:image / twitter:image URLs.
# Must match PUBLIC_APP_URL in dev; set to the actual domain in production builds.
VITE_PUBLIC_APP_URL=http://localhost:5173

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://brewform:brewform@localhost:5432/brewform
DATABASE_PROVIDER=postgresql

# === Cache Driver ===
# "memory" for an in-memory/local cache (e.g., for development), "deno-kv" for production
CACHE_DRIVER=memory

# === Authentication ===
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# When "Remember Me" is checked on login, the refresh token uses this expiry.
# Default: 180d (~6 months). Supports s/m/h/d/M suffixes.
# M = 30 days (not calendar month).
JWT_REMEMBER_ME_EXPIRY=180d

# === Admin Setup ===
ADMIN_EMAIL=admin@brewform.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080

# === Email (SMTP) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@brewform.local

# === OpenAPI ===
OPENAPI_ENABLED=true

# === Registration ===
# Set to 'false' to disable new user registrations.
# Existing users can still log in. Default: true.
ENABLE_REGISTRATION=true

# === Storage ===
STORAGE_DRIVER=local

# S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=brewform-uploads
S3_ACCESS_KEY=GK2ccae54ad3793a1324aba797fd9c62fc
S3_SECRET_KEY=023662d00d0b2b61b6f6f42717a9284f56e2912a73296fe750d4d7b50c98255a
S3_PUBLIC_URL=http://localhost:3902/brewform-uploads

# === Garage S3 (local development) ===
# Passed to the Garage container via compose.yml env_file.
# These values are pre-generated for local development.
# In production, generate new ones with:
#   printf "GK%s" $(openssl rand -hex 16)
#   openssl rand -hex 32
#   openssl rand -hex 32
GARAGE_DEFAULT_ACCESS_KEY=GK2ccae54ad3793a1324aba797fd9c62fc
GARAGE_DEFAULT_SECRET_KEY=023662d00d0b2b61b6f6f42717a9284f56e2912a73296fe750d4d7b50c98255a
GARAGE_DEFAULT_BUCKET=brewform-uploads
GARAGE_RPC_SECRET=cd87874aea22c73f5766ced61ac82193c2abe2f4c0f13b235c6258a0b27aeace
GARAGE_ADMIN_TOKEN=dev-admin-token-change-me-in-production

# === PostgreSQL ===
POSTGRES_USER=brewform
POSTGRES_PASSWORD=brewform
POSTGRES_DB=brewform

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@brewform.local
PGADMIN_DEFAULT_PASSWORD=admin
