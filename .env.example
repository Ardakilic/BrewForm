# ============================================================
# BrewForm — Local Development Environment (compose infra)
# ============================================================
# This file is read by docker compose for LOCAL DEVELOPMENT infrastructure only
# (Postgres, Garage, pgAdmin, Mailpit, denokv). It is NOT used by Coolify.
#
# API runtime env vars:    apps/api/.env.example  (paste into Coolify API resource)
# Web build-time env vars: apps/web/.env.example (set as GitHub Secrets)
# ============================================================

# === Cache Driver (local dev) ===
# "memory" for local dev (no denokv needed), "deno-kv" to test the sidecar.
# The prod profile (make prod-up) and Coolify use "deno-kv".
CACHE_DRIVER=memory

# === Deno KV (remote denokv sidecar) ===
# URL of the denokv server. Defaults to http://denokv:4512 (the compose service name).
# In Coolify, use the denokv resource's internal hostname: http://denokv-<uuid>:4512
DENO_KV_URL=http://denokv:4512
# Bearer token for the denokv server. Generate with: openssl rand -hex 32
# Must match the --access-token passed to the denokv container in compose.yml / Coolify.
# Leave empty when CACHE_DRIVER=memory (unused).
DENO_KV_ACCESS_TOKEN=

# === PostgreSQL (local dev container) ===
POSTGRES_USER=brewform
POSTGRES_PASSWORD=brewform
POSTGRES_DB=brewform

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@brewform.local
PGADMIN_DEFAULT_PASSWORD=admin

# === Garage S3 (local development) ===
# Passed to the Garage container via compose.yml env_file.
# These values are pre-generated for local development.
# In production, generate new ones with:
#   printf "GK%s" $(openssl rand -hex 16)
#   openssl rand -hex 32
#   openssl rand -hex 32
GARAGE_DEFAULT_ACCESS_KEY=GK2ccae54ad3793a1324aba797fd9c62fc
GARAGE_DEFAULT_SECRET_KEY=023662d00d0b2b61b6f6f42717a9284f56e2912a73296fe750d4d7b50c98255a
GARAGE_DEFAULT_BUCKET=brewform-uploads
GARAGE_RPC_SECRET=cd87874aea22c73f5766ced61ac82193c2abe2f4c0f13b235c6258a0b27aeace
GARAGE_ADMIN_TOKEN=dev-admin-token-change-me-in-production