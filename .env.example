# === Application ===
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=debug

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://brewform:brewform@localhost:5432/brewform?connection_limit=10&pool_timeout=30
DATABASE_PROVIDER=postgresql

# === Cache Driver ===
CACHE_DRIVER=deno-kv

# === Authentication ===
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# === Admin Setup ===
ADMIN_EMAIL=admin@brewform.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# === Email (SMTP) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@brewform.local

# === OpenAPI ===
OPENAPI_ENABLED=true

# === Storage ===
STORAGE_DRIVER=local

# S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=brewform-uploads
S3_ACCESS_KEY=GK<your-generated-key>
S3_SECRET_KEY=<your-generated-secret>
S3_PUBLIC_URL=http://localhost:3902/brewform-uploads

# === Garage S3 (local development) ===
# Passed to the Garage container via compose.yml env_file.
# Copy this file to .env and replace placeholders with real keys.
# Generate keys with: garage key new --name default
GARAGE_DEFAULT_ACCESS_KEY=GK<your-generated-access-key>
GARAGE_DEFAULT_SECRET_KEY=<your-generated-secret-key>
GARAGE_DEFAULT_BUCKET=brewform-uploads
# Generate rpc_secret with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-to-a-64-char-hex-string
GARAGE_ADMIN_TOKEN=change-me-to-a-strong-token

# === PostgreSQL ===
POSTGRES_USER=brewform
POSTGRES_PASSWORD=brewform
POSTGRES_DB=brewform

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@brewform.local
PGADMIN_DEFAULT_PASSWORD=admin
