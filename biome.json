{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!renovate.json", "!files", "!openspec"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noAutofocus": "warn",
            "noLabelWithoutControl": "warn",
            "noNoninteractiveElementToInteractiveRole": "warn",
            "noStaticElementInteractions": "warn",
            "useFocusableInteractive": "warn",
            "useKeyWithClickEvents": "warn",
            "useSemanticElements": "warn"
          },
          "correctness": { "useExhaustiveDependencies": "warn" },
          "security": { "noDangerouslySetInnerHtml": "warn" },
          "suspicious": { "noArrayIndexKey": "warn" }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/api/**",
        "!apps/web/src/routes/**",
        "!apps/web/src/**/*.data.ts",
        "!apps/web/src/contexts/AuthContext.tsx",
        "!apps/web/src/hooks/useStaticCacheSync.ts",
        "!apps/web/src/**/*.test.ts",
        "!apps/web/src/**/*.test.tsx",
        "!apps/web/src/test-utils/**",
        "!apps/web/src/test-setup.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/api/client.ts", "**/api/index.ts", "**/api/static-cache.ts"],
                    "message": "Pages and components must not import the API client: read data in a route loader (<Page>.data.ts), write through a route action, or use a fetcher against a resources/* route (ADR-018). Types live in api/types.ts and ApiError in api/errors.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
