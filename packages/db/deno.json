{
  "name": "@brewform/db",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "tasks": {
    "build": "deno run -A npm:drizzle-kit generate",
    "generate": "deno run -A npm:drizzle-kit generate",
    "migrate": "deno run -A npm:drizzle-kit migrate",
    "push": "deno run -A npm:drizzle-kit push",
    "studio": "deno run -A npm:drizzle-kit studio --host=0.0.0.0 --port=5555",
    "lint": "deno lint src/",
    "check": "deno check src/index.ts src/schema.ts",
    "test": "deno test --allow-all src/"
  }
}
