{
  "name": "@brewform/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio --host=0.0.0.0 --port=5555",
    "seed": "tsx src/seed.ts",
    "build": "drizzle-kit generate",
    "check": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@brewform/shared": "workspace:*",
    "bcryptjs": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
