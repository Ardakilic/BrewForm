# ============================================================
# BrewForm — Production environment (for compose.production.yml)
# ============================================================
# Usage:
#   cp .env.production.example .env.production   # then edit the values below
#   docker compose --env-file .env.production -f compose.production.yml up -d
#
# NOTE: always pass --env-file. The repo's .env holds LOCAL DEV defaults and
# is auto-loaded by compose — without --env-file it would silently leak dev
# values (e.g. POSTGRES_PASSWORD=brewform) into production.
# ============================================================

# --- Required: set these before the first run ---
POSTGRES_PASSWORD=change-me-to-a-strong-password
API_DOMAIN=api.brewform.example.com
WEB_DOMAIN=brewform.example.com
# Min 16 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-in-production

# --- Optional (defaults shown) ---
# POSTGRES_USER=brewform
# POSTGRES_DB=brewform
# CACHE_DRIVER=valkey
# VALKEY_URL=valkey://valkey:6379
# API_PORT=8000
# WEB_PORT=80
# LOG_LEVEL=info
# OPENAPI_ENABLED=false
# ENABLE_REGISTRATION=true
# STORAGE_DRIVER=local
# ADMIN_EMAIL=admin@brewform.local
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123456
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
