# ============================================================
# BrewForm — Production environment (for compose.production.yml)
# ============================================================
# Usage:
#   cp .env.production.example .env.production   # then edit the values below
#   docker compose --env-file .env.production -f compose.production.yml up -d
#
# NOTE: always pass --env-file. The repo's .env holds LOCAL DEV defaults and
# is auto-loaded by compose — without --env-file it would silently leak dev
# values (e.g. POSTGRES_PASSWORD=brewform) into production.
# ============================================================

# --- Required: set these before the first run ---
# Empty values fail fast via the ${VAR:?} guards in compose.production.yml.
POSTGRES_PASSWORD=
API_DOMAIN=api.brewform.example.com
WEB_DOMAIN=brewform.example.com
ADMIN_PASSWORD=
# Valkey cache password (requirepass). Generate with: openssl rand -hex 32
# URL-encode special chars if you override REDIS_URL manually.
VALKEY_PASSWORD=
# Min 16 chars. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Optional (defaults shown) ---
# POSTGRES_USER=brewform
# POSTGRES_DB=brewform
# CACHE_ENABLED=true
# CACHE_DRIVER=redis
# REDIS_URL defaults to redis://:<VALKEY_PASSWORD>@valkey:6379 — override only
# for an external Redis-protocol server, e.g. # REDIS_URL=redis://:secret@host:6379
# WEB_PORT=80
# LOG_LEVEL=info
# OPENAPI_ENABLED=false
# ENABLE_REGISTRATION=true
# STORAGE_DRIVER=local
# ADMIN_EMAIL=admin@brewform.local
# ADMIN_USERNAME=admin
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
