# ============================================================
# BrewForm — Production environment (for compose.production.yml)
# ============================================================
# Usage:
#   cp .env.production.example .env.production   # then fill in the required values
#   make prod-pull && make prod-up               # = docker compose --env-file .env.production -f compose.production.yml …
# Guide: docs/deployment_compose.md
#
# NOTE: always pass --env-file (the make prod-* targets do). The repo's .env holds LOCAL DEV
# defaults and is auto-loaded by compose — without --env-file it would silently leak dev
# values (e.g. POSTGRES_PASSWORD=brewform) into production.
#
# A blank value counts as unset for the API (its default applies). The five required values
# below are the exception: blank ones fail fast via the ${VAR:?} guards in
# compose.production.yml.
# ============================================================

# --- Required: set these before the first run ---
# Postgres password. URL-encode #, @, : and / (it is put into the API's DATABASE_URL).
POSTGRES_PASSWORD=
# Public host name of the site (no scheme). The browser reaches the API through it too
# (same-origin edge); API_DOMAIN is no longer used.
WEB_DOMAIN=brewform.example.com
# First install only: seeds the admin account when the database is empty.
ADMIN_PASSWORD=
# Valkey password (requirepass). Generate with: openssl rand -hex 32
# Must stay URL-safe (interpolated raw into the default REDIS_URL).
VALKEY_PASSWORD=
# Min 16 chars. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Optional: images and project (defaults shown) ---
# IMAGE_TAG=latest              # or a full commit SHA / vX.Y.Z to pin or roll back
# API_IMAGE=ghcr.io/ardakilic/brewform-api
# WEB_IMAGE=ghcr.io/ardakilic/brewform-web
# COMPOSE_PROJECT_NAME=brewform-prod   # an install from before wave 6: its old project name
# WEB_PORT=80

# --- Optional: data locations (defaults shown) ---
# A value starting with /, . or ~ is a host folder (use an absolute or ./ path; the uploads
# folder must be owned by 1000:1000); anything else must be a declared volume name (uploads, postgres_data, backups).
# UPLOADS_SOURCE=uploads
# POSTGRES_DATA_SOURCE=postgres_data
# BACKUPS_SOURCE=backups

# --- Optional: photo storage ---
# Recommended for production: object storage, then skip the uploads archive in backups.
# STORAGE_DRIVER=s3
# BACKUP_UPLOADS=false
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # account endpoint, no bucket
# S3_REGION=auto
# S3_BUCKET=brewform-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cdn.brewform.example.com
# Default without these lines: STORAGE_DRIVER=local (photos in the uploads source).

# --- Optional: web edge ---
# Who may send X-Forwarded-For to the edge: unset = private_ranges (a proxy on this host or
# a private network); empty (TRUSTED_PROXIES=) = trust no proxy; Cloudflare connecting
# directly = its ranges, space separated (https://www.cloudflare.com/ips/).
# TRUSTED_PROXIES=private_ranges
# Request body cap at the edge; keep it above the API's photo cap (~11.06 MiB).
# EDGE_MAX_BODY_SIZE=16MB
# VITE_API_URL=/api/v1          # an absolute URL selects the split-domain topology

# --- Optional: backups ---
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
# BACKUP_UPLOADS=true

# --- Optional: resources and logs ---
# API_MEMORY_LIMIT=1g
# WEB_MEMORY_LIMIT=256m
# POSTGRES_MEMORY_LIMIT=1g
# VALKEY_MEMORY_LIMIT=256m
# MIGRATE_MEMORY_LIMIT=512m
# BACKUP_MEMORY_LIMIT=512m
# RESTORE_MEMORY_LIMIT=512m
# VALKEY_MAXMEMORY=192mb        # keep below VALKEY_MEMORY_LIMIT (policy stays noeviction)
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=5

# --- Optional: API overrides (compose defaults shown) ---
# Client IP behind the edge: hops/1 is right in every topology (the edge sends one hop);
# TRUST_PROXY=cloudflare when Cloudflare connects directly (uses CF-Connecting-IP only from
# Cloudflare addresses).
# TRUST_PROXY=hops
# TRUST_PROXY_HOPS=1
# Extra trusted edge CIDRs for TRUST_PROXY=cloudflare, comma separated:
# TRUST_PROXY_CIDRS=
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORE=redis
# RATE_LIMIT_GLOBAL_MAX=100
# CACHE_ENABLED=true
# CACHE_DRIVER=redis
# CACHE_MEMORY_MAX_ENTRIES=10000
# DB_STATEMENT_TIMEOUT_MS=10000  # per-statement limit in ms; 0 disables
# REDIS_URL defaults to redis://:<VALKEY_PASSWORD>@valkey:6379 — override only
# for an external Redis-protocol server, e.g. # REDIS_URL=redis://:secret@host:6379
# POSTGRES_USER=brewform
# POSTGRES_DB=brewform
# LOG_LEVEL=info
# OPENAPI_ENABLED=false
# ENABLE_REGISTRATION=true
# ADMIN_EMAIL=admin@brewform.local
# ADMIN_USERNAME=admin
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d
# JWT_REMEMBER_ME_EXPIRY=180d
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=noreply@<WEB_DOMAIN>
