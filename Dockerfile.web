# ============================================================
# BrewForm — Dockerfile.web (Web SPA image)
#
# Stages:
#   deps    — install / cache pnpm dependencies (same as the API Dockerfile)
#   builder — Vite build of apps/web → apps/web/dist (VITE_* baked in at build time)
#   runner  — Caddy on :80: the static SPA, an always-local /healthz, and (opt-in through
#             API_UPSTREAM) the same-origin edge that reverse-proxies the API paths
# ============================================================

# --- Stage 1: Dependencies ---
# Copies only manifest files, prefetches the pnpm store, then copies the full
# source and installs offline. Identical to the API Dockerfile's `deps` stage
# so both images share the same dependency graph and lockfile resolution.
FROM node:26.13.0-trixie-slim AS deps
WORKDIR /app
RUN npm install -g --allow-scripts=pnpm pnpm@12.18.0
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
RUN pnpm fetch
COPY . .
RUN pnpm install --frozen-lockfile --offline

# --- Stage 2: Build (Vite) ---
# Production Vite build of the web workspace. The VITE_* values are passed as
# build ARGs, promoted to ENV, and inlined into the bundle by Vite's `define`
# (apps/web/vite.config.ts). The defaults match the dev/local topology.
FROM deps AS builder
WORKDIR /app
# Build-time args → ENV so Vite's define picks them up
ARG VITE_API_URL=/api/v1
ARG VITE_PUBLIC_APP_URL=http://localhost:8080
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL
RUN pnpm --filter @brewform/web run build
# Output is at apps/web/dist/

# --- Stage 3: Runtime (Caddy) ---
# Caddy serving the compiled SPA with a try_files fallback, configured at container start
# by docker-web-entrypoint.sh (see its header for every variable):
#   - VITE_API_URL overrides the baked-in API URL through /config.js (no rebuild);
#   - API_UPSTREAM (host:port) turns on the same-origin edge: /api/*, /uploads/*, /share/*
#     and /health are proxied to the API with the client IP in X-Forwarded-For/X-Real-IP,
#     bodies capped at EDGE_MAX_BODY_SIZE (default 16MB); unset = static files only;
#   - TRUSTED_PROXIES (`private_ranges` and/or CIDRs) sets Caddy's trusted_proxies;
#   - PUBLIC_APP_URL replaces the build-time public URL (recorded below as
#     BREWFORM_BUILD_PUBLIC_APP_URL) in index.html og/twitter images and robots.txt.
# The entrypoint writes its optional snippets into /etc/caddy/conf.d and
# /etc/caddy/global.d, which the Caddyfile imports (an empty glob is not an error).
#
# Health: the HEALTHCHECK probes the local /healthz with the BusyBox wget of the Alpine
# base (nothing is installed for it); /healthz never touches the API upstream.
#
# Pinned to a specific Caddy patch for reproducible builds. To track the latest
# 2.x patch automatically instead, swap the line below for: FROM caddy:2-alpine
FROM caddy:2.11.9-alpine AS runner
# Re-declared so the entrypoint knows which origin the build baked into index.html and
# robots.txt (PUBLIC_APP_URL replaces exactly that string at runtime).
ARG VITE_PUBLIC_APP_URL=http://localhost:8080
ENV BREWFORM_BUILD_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL
COPY --from=builder /app/apps/web/dist /usr/share/caddy
# Production Caddyfile on :80 (the repo-root Caddyfile is the :8080 preview one).
COPY apps/web/Caddyfile /etc/caddy/Caddyfile
# Entrypoint: applies the runtime configuration above, then execs Caddy.
COPY docker-web-entrypoint.sh /docker-web-entrypoint.sh
RUN chmod +x /docker-web-entrypoint.sh \
  && mkdir -p /etc/caddy/conf.d /etc/caddy/global.d
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --start-interval=1s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1/healthz"]
ENTRYPOINT ["/docker-web-entrypoint.sh"]
