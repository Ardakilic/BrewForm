{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ]
  // No customManagers: the built-in `npm` manager tracks package.json +
  // pnpm-lock.yaml (including `catalog:` pins via pnpm-workspace.yaml), and the
  // built-in `node` manager tracks the Node version in `.nvmrc`. The built-in
  // `github-actions` manager updates .github/workflows/ci.yml; with
  // helpers:pinGitHubActionDigests it pins actions to full commit SHAs and keeps
  // each SHA and its `# vX.Y.Z` comment up to date.
}
